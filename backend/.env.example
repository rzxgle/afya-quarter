# mock = dados fictícios (sem Jira) | jira = produção
DATA_SOURCE=mock

# Necessário apenas quando DATA_SOURCE=jira
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Base pública para links de épicos/itens
JIRA_BROWSE_BASE=https://medcel.atlassian.net/browse/

# TTL do cache (segundos) — equivalente ao ttl=300 original
CACHE_TTL_SECONDS=300

# Origens liberadas para o front (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
